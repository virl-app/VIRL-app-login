{
  "functions": {
    "api/cron/trends-refresh.js": {
      "maxDuration": 300
    },
    "api/strategy.js": {
      "maxDuration": 180
    },
    "api/render.js": {
      "maxDuration": 60
    },
    "api/cron/strategist-touches.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/email-triggers",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/email-triggers?job=reminders",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron/cleanup-rate-limits",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/playbook-refresh",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/trends-refresh?tier=global",
      "schedule": "0 7 * * 6"
    },
    {
      "path": "/api/cron/trends-refresh?tier=segment",
      "schedule": "10 7 * * 6"
    },
    {
      "path": "/api/cron/trend-health",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/strategist-touches",
      "schedule": "5 * * * *"
    }
  ]
}
