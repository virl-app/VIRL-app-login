{
  "name": "virl-app-login",
  "version": "1.0.0",
  "private": true,
  "description": "VIRL app \u2014 single-page React frontend (authored in index.html, JSX precompiled by scripts/build.mjs into dist/) plus Vercel serverless API functions in /api.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:index": "node scripts/check-index-syntax.mjs",
    "check:compliance": "node scripts/check-compliance.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "check:strategist": "node scripts/check-strategist.mjs",
    "check:trends": "node scripts/check-trend-personalization.mjs",
    "check:rating": "node scripts/check-rating-upsert.mjs",
    "check:composer": "node scripts/check-composer-fields.mjs",
    "check": "npm run check:index && npm run check:compliance && npm run check:voice && npm run check:strategist && npm run check:trends && npm run check:trendsource && npm run check:rating && npm run check:composer && npm run check:strategy && npm run check:autogen && npm run check:anthropic && npm run check:trendhealth && npm run check:firstplan && npm run check:build",
    "audit:trends": "node scripts/audit-trend-research.mjs",
    "og:image": "node scripts/og-image.mjs",
    "check:trendsource": "node scripts/check-trend-source-health.mjs",
    "check:strategy": "node scripts/check-strategy-build.mjs",
    "check:autogen": "node scripts/check-autogen-parse.mjs",
    "check:anthropic": "node scripts/check-anthropic-params.mjs",
    "check:trendhealth": "node scripts/check-trend-health-alert.mjs",
    "check:firstplan": "node scripts/check-first-plan.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pdf-lib": "^1.17.1",
    "resend": "^4.0.0",
    "satori": "^0.12.0",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@babel/standalone": "7.23.2",
    "sucrase": "^3.35.0"
  }
}
